# Byte-compiled / optimized / generated files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
.env
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
*.whl
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Pytest / coverage / testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/
nosetests.xml
test-results/

# Mypy / type checkers
.mypy_cache/
.pyre/

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db

# Logs and runtime files
*.log
logs/
*.pid
*.sock

# Jupyter
.ipynb_checkpoints

# Secrets / local env files (keep .env.example tracked)
.env.local
.env.*.local
.env.test
.env.production
secrets.*
*.key

# Database files (if you add local DBs later)
*.sqlite3
*.db
*.sqlite

# Static analysis / caches
__pypackages__/
.meter_cache/

# Misc
*.swp
*~ 
*.bak

# Optional: ignore editor-specific project files
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json

